# Template for local-only deploy configuration.
# Copy this file to ".env.local" and fill in real values.
# .env.local is git-ignored; never commit it.
#
# Used by: blueprint-verso/scripts/publish.sh

# --- required ------------------------------------------------------------

# rsync-style SSH target. Either an alias defined in ~/.ssh/config
# (recommended) or a literal "user@host". Examples:
#   VPS_SSH_TARGET=replace-with-ssh-alias
#   VPS_SSH_TARGET=replace-with-user@host
VPS_SSH_TARGET=replace-me

# Remote directory that should hold the built site. The contents of
# blueprint-verso/_out/site/html-multi/ will be rsynced into this
# directory, so it must be the directory you want the public to see
# (i.e. the document root for the public URL you are publishing to).
#   1Panel convention example:
#     /opt/1panel/www/sites/<your-domain>/QuadraticNumberFields
#   nginx/Apache static root example:
#     /var/www/qnf-blueprint
VPS_TARGET_DIR=replace-me

# --- optional ------------------------------------------------------------

# Extra `ssh` options forwarded to rsync, e.g. a non-default port or
# an explicit identity file. Leave empty if ~/.ssh/config already
# covers your alias.
#   VPS_SSH_OPTIONS=-p 2222 -i ~/.ssh/id_ed25519
VPS_SSH_OPTIONS=

# If the SSH login user is not the 1Panel web-server user, set this
# to "user:group" and the script will chown the published files. With
# 1Panel the web server typically runs as "www-data:www-data" or
# "1panel:1panel" depending on the panel version. Leave empty to skip.
VPS_TARGET_OWNER=

# Directory mode applied after chown. 755 is the common static-site
# default; 1Panel sometimes expects 755 as well.
VPS_TARGET_MODE=755

# --- ad-hoc flags --------------------------------------------------------
# These are usually left empty. They exist so the script can be run
# non-destructively while you are wiring things up.
#
# SKIP_RENDER=1  skip the slow Verso HTML render, publish the existing
#                _out/site/html-multi/. Use when the rendered site
#                already exists and you only want to republish.
# SKIP_BUILD=1   skip the local build entirely (including the
#                `lake build` and the Verso render). Use when the
#                _out/site/html-multi/ from a previous run is already
#                what you want to push.
# DRY_RUN=1      rsync --dry-run only; nothing written remotely
#
# Note: SKIP_RENDER is finer-grained than SKIP_BUILD. With both set,
# SKIP_BUILD wins (it skips the call into ci-pages.sh entirely).
SKIP_RENDER=
SKIP_BUILD=
DRY_RUN=
