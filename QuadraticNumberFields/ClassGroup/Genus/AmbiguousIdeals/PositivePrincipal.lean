  letI : P.IsPrime := hPprime
  letI : P.LiesOver (𝔭(p)) := ⟨hcomap.symm⟩
  rw [absNorm_eq_prime_pow_inertiaDeg_of_comap_eq_p d hp hcomap,
    Ideal.inertiaDeg_eq_one_of_isRamifiedIn (p := 𝔭(p)) (S := R)
      (by norm_num : ringChar ℤ ≠ 2) hpbot hram,
