        (FractionRing.algEquiv R (Qsqrtd (d : ℚ)) (γ : FractionRing R)) : ℝ) *
        (Qsqrtd.norm
          (FractionRing.algEquiv R (Qsqrtd (d : ℚ)) (x : FractionRing R)) : ℝ)
