private theorem qsqrt_norm_mul_algebraMap_unit
    (d : ℤ) [Fact (Squarefree d)] [Fact (d ≠ 1)]
    {γ : (FractionRing (NumberField.RingOfIntegers (Qsqrtd (d : ℚ))))ˣ}
    (ε : (NumberField.RingOfIntegers (Qsqrtd (d : ℚ)))ˣ) :
