import QuadraticNumberFields.ZOnePlusSqrtdOverTwo.Inclusion
import Mathlib.RingTheory.Conductor

/-!
# The conductor of the square-root suborder

The conductor of the integer subalgebra generated by `2 * ω - 1` in
`ZOnePlusSqrtdOverTwo k` is the principal ideal generated by two. Membership
amounts to both integer coordinates being even. These statements hold for
every integer `k`, including reducible quadratic models.

Adapted and generalized from `BakerHeegnerStark/ComplexMultiplication/Orders/HalfIntegral.lean`
at commit `42c273b84c375c93258ca00774d7d3efe314d7ef`:
<https://github.com/WangFrankie/BakerHeegnerStark/blob/42c273b84c375c93258ca00774d7d3efe314d7ef/BakerHeegnerStark/ComplexMultiplication/Orders/HalfIntegral.lean>.
-/

open scoped QuadraticAlgebra

namespace ZOnePlusSqrtdOverTwo

/-- The conductor of the square-root suborder consists of elements with even coordinates. -/
theorem mem_conductor_iff_even_coordinates (k : ℤ) (z : ZOnePlusSqrtdOverTwo k) :
    z ∈ conductor ℤ (2 * QuadraticAlgebra.omega - 1 : ZOnePlusSqrtdOverTwo k) ↔
      Even z.re ∧ Even z.im := by
  simp only [mem_conductor_iff,
    ← range_fromZsqrtd k (rfl : (1 + 4 * k : ℤ) = 1 + 4 * k),
    mem_range_fromZsqrtd_iff]
  constructor
  · intro h
    have hz : Even z.im := by simpa using h 1
    have hω := h QuadraticAlgebra.omega
    obtain ⟨n, hn⟩ := hz
    obtain ⟨m, hm⟩ := hω
    simp only [QuadraticAlgebra.im_mul, QuadraticAlgebra.re_omega,
      QuadraticAlgebra.im_omega, mul_one, mul_zero, one_mul, add_zero] at hm
    exact ⟨⟨m - n, by omega⟩, ⟨n, hn⟩⟩
  · rintro ⟨⟨m, hm⟩, ⟨n, hn⟩⟩ w
    refine ⟨m * w.im + n * w.re + n * w.im, ?_⟩
    simp only [QuadraticAlgebra.im_mul, one_mul, hm, hn]
    ring

/-- The conductor of the square-root suborder is the principal ideal generated by two. -/
theorem conductor_eq_span_two (k : ℤ) :
    conductor ℤ (2 * QuadraticAlgebra.omega - 1 : ZOnePlusSqrtdOverTwo k) =
      Ideal.span {2} := by
  ext z
  rw [mem_conductor_iff_even_coordinates, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨⟨m, hm⟩, ⟨n, hn⟩⟩
    refine ⟨⟨m, n⟩, ?_⟩
    apply QuadraticAlgebra.ext <;> simp [hm, hn, two_mul]
  · rintro ⟨w, rfl⟩
    constructor
    · exact ⟨w.re, by simp [two_mul]⟩
    · exact ⟨w.im, by simp [two_mul]⟩

end ZOnePlusSqrtdOverTwo
