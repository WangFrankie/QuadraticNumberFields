import QuadraticNumberFields.Zsqrtd.Basic
import QuadraticNumberFields.ZOnePlusSqrtdOverTwo.Basic
import QNFMathlib.Algebra.QuadraticAlgebra.Conductor
import QNFMathlib.Algebra.QuadraticAlgebra.Index
import QNFMathlib.Algebra.QuadraticAlgebra.Order

/-!
# The square-root suborder of the half-integer model

For `d = 1 + 4 * k`, the square-root generator maps to `2 * ω - 1`.
The coordinate formula identifies the image by the parity of its second
coordinate. All results are algebraic: `k` may be any integer, and no domain,
squarefreeness, positivity, or complex-realization hypothesis is imposed.
The map specializes mathlib's `QuadraticAlgebra.changeGenerator`; the range
and index results specialize the general quadratic-algebra theorems in `QNFMathlib`,
and the image in the rational model is a quadratic order.

Adapted and generalized from `BakerHeegnerStark/ComplexMultiplication/Orders/HalfIntegral.lean`
at commit `42c273b84c375c93258ca00774d7d3efe314d7ef`:
<https://github.com/WangFrankie/BakerHeegnerStark/blob/42c273b84c375c93258ca00774d7d3efe314d7ef/BakerHeegnerStark/ComplexMultiplication/Orders/HalfIntegral.lean>.
-/

open scoped QuadraticAlgebra

namespace ZOnePlusSqrtdOverTwo

variable {d : ℤ}

/-- The square-root model embeds in the half-integer model by `√d ↦ 2ω - 1`. -/
noncomputable def fromZsqrtd (k : ℤ) (hd : d = 1 + 4 * k) :
    QuadraticNumberFields.Zsqrtd d →ₐ[ℤ] ZOnePlusSqrtdOverTwo k :=
  QuadraticAlgebra.changeGenerator k 1 2 (-1) (by rw [hd]; ring) (by norm_num)

/-- The inclusion sends `a + b√d` to `a + b(2ω - 1)`. -/
theorem fromZsqrtd_apply (k : ℤ) (hd : d = 1 + 4 * k)
    (z : QuadraticNumberFields.Zsqrtd d) :
    fromZsqrtd k hd z = (z.re : ZOnePlusSqrtdOverTwo k) +
      (z.im : ZOnePlusSqrtdOverTwo k) * (2 * QuadraticAlgebra.omega - 1) := by
  simp [fromZsqrtd, QuadraticAlgebra.changeGenerator, QuadraticAlgebra.lift,
    Algebra.smul_def, sub_eq_add_neg]

/-- The first coordinate of the suborder inclusion. -/
@[simp]
theorem fromZsqrtd_re (k : ℤ) (hd : d = 1 + 4 * k)
    (z : QuadraticNumberFields.Zsqrtd d) :
    (fromZsqrtd k hd z).re = z.re - z.im := by
  simp [fromZsqrtd, sub_eq_add_neg]

/-- The second coordinate of the suborder inclusion. -/
@[simp]
theorem fromZsqrtd_im (k : ℤ) (hd : d = 1 + 4 * k)
    (z : QuadraticNumberFields.Zsqrtd d) :
    (fromZsqrtd k hd z).im = 2 * z.im := by
  simp [fromZsqrtd, mul_comm]

/-- The distinguished square-root generator maps to `2ω - 1`. -/
@[simp]
theorem fromZsqrtd_sqrtd (k : ℤ) (hd : d = 1 + 4 * k) :
    fromZsqrtd k hd QuadraticNumberFields.Zsqrtd.sqrtd =
      2 * QuadraticAlgebra.omega - 1 := by
  rw [fromZsqrtd_apply]
  simp

/-- The suborder inclusion is injective, including for reducible quadratic models. -/
theorem fromZsqrtd_injective (k : ℤ) (hd : d = 1 + 4 * k) :
    Function.Injective (fromZsqrtd k hd) := by
  exact QuadraticAlgebra.changeGenerator_injective k 1 2 (-1) _ _
    (isRegular_iff_ne_zero.mpr (by norm_num))

/-- The image consists exactly of the elements with even second coordinate. -/
theorem mem_range_fromZsqrtd_iff (k : ℤ) (hd : d = 1 + 4 * k)
    (z : ZOnePlusSqrtdOverTwo k) :
    z ∈ (fromZsqrtd k hd).range ↔ Even z.im := by
  simpa [fromZsqrtd, even_iff_two_dvd] using
    QuadraticAlgebra.mem_range_algHom_iff_dvd_im (fromZsqrtd k hd) z

/-- The image is the integer subalgebra generated by `2ω - 1`. -/
theorem range_fromZsqrtd (k : ℤ) (hd : d = 1 + 4 * k) :
    (fromZsqrtd k hd).range =
      Algebra.adjoin ℤ ({2 * QuadraticAlgebra.omega - 1} : Set (ZOnePlusSqrtdOverTwo k)) := by
  simpa [fromZsqrtd, Algebra.smul_def, sub_eq_add_neg] using
    QuadraticAlgebra.range_algHom_eq_adjoin (fromZsqrtd k hd)

/-- The square-root suborder has additive index two in every half-integer model. -/
theorem index_range_fromZsqrtd (k : ℤ) (hd : d = 1 + 4 * k) :
    (fromZsqrtd k hd).toRingHom.range.toAddSubgroup.index = 2 := by
  simpa [fromZsqrtd] using QuadraticAlgebra.index_range_algHom (fromZsqrtd k hd)

/-- The square-root suborder is a quadratic order in every half-integer model. -/
theorem isQuadraticOrder_range_fromZsqrtd (k : ℤ) (hd : d = 1 + 4 * k) :
    ((fromZsqrtd k hd).range.map (QuadraticAlgebra.toRat k 1)).IsQuadraticOrder := by
  rw [QuadraticAlgebra.isQuadraticOrder_map_range_iff, fromZsqrtd_im]
  simp

end ZOnePlusSqrtdOverTwo
