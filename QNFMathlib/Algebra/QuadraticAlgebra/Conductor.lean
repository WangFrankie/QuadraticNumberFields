import Mathlib.Algebra.QuadraticAlgebra.Basic
import Mathlib.RingTheory.Conductor

/-!
# Generated subalgebras and conductors of quadratic algebras

For an element `x` of a quadratic algebra over a commutative ring, membership in the
subalgebra generated by `x` is equivalent to divisibility of the imaginary coordinate by
`x.im`. Its conductor is the principal ideal generated by the scalar `x.im`.
The range of any homomorphism between quadratic algebras is the subalgebra generated by
the image of `omega`, so the same divisibility criterion describes that range.

These results require neither injectivity nor a non-zero-divisor hypothesis.

Generalized from Frankie Wang's half-integral order calculations in
[`BakerHeegnerStark.ComplexMultiplication.Orders.HalfIntegral`](https://github.com/WangFrankie/BakerHeegnerStark/blob/42c273b84c375c93258ca00774d7d3efe314d7ef/BakerHeegnerStark/ComplexMultiplication/Orders/HalfIntegral.lean).
-/

namespace QuadraticAlgebra

variable {R : Type*} [CommRing R] {a b : R}

/-- An element lies in the subalgebra generated by `x` exactly when its imaginary
coordinate is divisible by `x.im`. -/
theorem mem_adjoin_singleton_iff_dvd_im (x y : QuadraticAlgebra R a b) :
    y ∈ Algebra.adjoin R ({x} : Set _) ↔ x.im ∣ y.im := by
  constructor
  · intro hy
    induction hy using Algebra.adjoin_induction with
    | mem z hz =>
      obtain rfl := Set.mem_singleton_iff.mp hz
      exact dvd_rfl
    | algebraMap r => simp
    | add z w hz hw hz' hw' =>
      exact dvd_add hz' hw'
    | mul z w hz hw hz' hw' =>
      exact dvd_add (dvd_add (hw'.mul_left _) (hz'.mul_right _))
        ((hz'.mul_left _).mul_right _)
  · rintro ⟨c, hc⟩
    have hrepr : y = algebraMap R _ (y.re - c * x.re) + c • x := by
      ext <;> simp [hc, mul_comm]
    rw [hrepr]
    exact (Algebra.adjoin R ({x} : Set _)).add_mem
      ((Algebra.adjoin R ({x} : Set _)).algebraMap_mem _)
      ((Algebra.adjoin R ({x} : Set _)).smul_mem
        (Algebra.self_mem_adjoin_singleton R x) _)

/-- The conductor of the subalgebra generated by `x` is the principal ideal generated
by the scalar `x.im`. This also holds when `x.im` is zero or a zero divisor. -/
theorem conductor_eq_span_im (x : QuadraticAlgebra R a b) :
    conductor R x = Ideal.span {algebraMap R (QuadraticAlgebra R a b) x.im} := by
  ext y
  rw [mem_conductor_iff, Ideal.mem_span_singleton, algebraMap_dvd_iff]
  constructor
  · intro hy
    have him : x.im ∣ y.im := by
      simpa using (mem_adjoin_singleton_iff_dvd_im x (y * 1)).mp (hy 1)
    have hsum : x.im ∣ y.re + b * y.im := by
      simpa using (mem_adjoin_singleton_iff_dvd_im x (y * omega)).mp (hy omega)
    exact ⟨by simpa using dvd_sub hsum (him.mul_left b), him⟩
  · rintro ⟨hre, him⟩ z
    rw [mem_adjoin_singleton_iff_dvd_im]
    exact dvd_add (dvd_add (hre.mul_right _) (him.mul_right _))
      ((him.mul_left _).mul_right _)

/-- The range of a homomorphism of quadratic algebras is generated by the image
of the canonical generator. -/
theorem range_algHom_eq_adjoin {a' b' : R}
    (f : QuadraticAlgebra R a' b' →ₐ[R] QuadraticAlgebra R a b) :
    f.range = Algebra.adjoin R {f omega} := by
  rw [← Algebra.map_top, ← adjoin_omega_eq_top, AlgHom.map_adjoin_singleton]

/-- Range membership is divisibility by the imaginary coordinate of the image
of the canonical generator, without any injectivity assumption. -/
theorem mem_range_algHom_iff_dvd_im {a' b' : R}
    (f : QuadraticAlgebra R a' b' →ₐ[R] QuadraticAlgebra R a b)
    (y : QuadraticAlgebra R a b) :
    y ∈ f.range ↔ (f omega).im ∣ y.im := by
  rw [range_algHom_eq_adjoin, mem_adjoin_singleton_iff_dvd_im]

end QuadraticAlgebra
