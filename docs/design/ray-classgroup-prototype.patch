+Released under Apache 2.0 license as described in the file LICENSE.
+Authors: Frankie Wang
+-/
+module
+
+public import Mathlib.NumberTheory.NumberField.InfinitePlace.Basic
+
+/-!
+# Ray Class Moduli
+
+-/
+
+@[expose] public noncomputable section
+
+namespace NumberField
+
+/-- A ray modulus for a number field.
+
+The finite part is an integral ideal of the ring of integers. The infinite part
+is a set of real infinite places. -/
+structure RayModulus (K : Type*) [Field K] [NumberField K] where
+  finitePart : Ideal (𝓞 K)
+  finitePart_ne_bot : finitePart ≠ ⊥
+  infinitePart : Set {w : InfinitePlace K // w.IsReal}
+
+namespace RayModulus
+
+/-- The modulus with trivial finite part and all real infinite places. Its ray
+class group is the narrow/strict class group. -/
+def narrow (K : Type*) [Field K] [NumberField K] : RayModulus K where
+  finitePart := ⊤
+  finitePart_ne_bot := top_ne_bot
+  infinitePart := Set.univ
+
+def trivial (K : Type*) [Field K] [NumberField K] : RayModulus K where
+  finitePart := ⊤
+  finitePart_ne_bot := top_ne_bot
+  infinitePart := ∅
+
+end RayModulus
+
+end NumberField
diff --git a/QNFMathlib/NumberTheory/NumberField/RayClassGroup/Basic.lean b/QNFMathlib/NumberTheory/NumberField/RayClassGroup/Basic.lean
