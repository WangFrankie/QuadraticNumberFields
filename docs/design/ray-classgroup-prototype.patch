@@ -0,0 +1,95 @@
+/-
+Copyright (c) 2026 Frankie Wang. All rights reserved.
+Released under Apache 2.0 license as described in the file LICENSE.
+Authors: Frankie Wang
+-/
+module
+
+public import Mathlib.RingTheory.ClassGroup
+public import QNFMathlib.NumberTheory.NumberField.RayClassGroup.Modulus
+
+/-!
+# Ray Class Groups
+-/
+
+@[expose] public noncomputable section
+
+open scoped nonZeroDivisors NumberField
+
+open FractionalIdeal
+
+variable {K : Type*} [Field K] [NumberField K]
+
+namespace NumberField
+namespace RayModulus
+
+/-- An integral ideal is coprime to the finite part of a ray modulus. -/
+def IsCoprimeIntegralIdeal (m : NumberField.RayModulus K) (I : (Ideal (𝓞 K))⁰) : Prop :=
+  IsCoprime (I : Ideal (𝓞 K)) m.finitePart
+
+/-- The group of fractional ideals coprime to the finite part of a ray modulus.
+
+This is defined as the subgroup generated by nonzero integral ideals coprime to
+the finite part. This avoids choosing valuations or reduced numerator-denominator
+representatives for fractional ideals. -/
+noncomputable def IdealGroup (m : NumberField.RayModulus K) :
+    Subgroup ((FractionalIdeal (𝓞 K)⁰ K)ˣ) :=
+  Subgroup.closure
+    {I | ∃ J : (Ideal (𝓞 K))⁰,
+      IsCoprimeIntegralIdeal m J ∧ FractionalIdeal.mk0 K J = I}
+
+/-- An element is positive at all real infinite places in the modulus. -/
+def IsPositiveAt (m : NumberField.RayModulus K) (x : K) : Prop :=
+  ∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, w ∈ m.infinitePart →
+    0 < w.1.embedding_of_isReal w.2 x
+
+/-- A fractional element is congruent to `1` modulo the finite part of a ray
+modulus if it admits a presentation `x = a / b` with denominator coprime to the
+finite part and `a ≡ b` modulo the finite part. -/
+def IsOneModFinitePart (m : NumberField.RayModulus K) (x : Kˣ) : Prop :=
+  ∃ a b : 𝓞 K,
+    b ≠ 0 ∧
+      IsCoprime (Ideal.span ({b} : Set (𝓞 K))) m.finitePart ∧
+        algebraMap (𝓞 K) K a = (x : K) * algebraMap (𝓞 K) K b ∧
+          a - b ∈ m.finitePart
+
+/-- Principal fractional ideals generated by elements satisfying the finite and
+infinite ray conditions, viewed as a subgroup of the coprime ideal group. -/
+noncomputable def PrincipalSubgroup (m : NumberField.RayModulus K) :
+    Subgroup m.IdealGroup :=
+  Subgroup.closure
+    {I | ∃ x : Kˣ,
+      m.IsOneModFinitePart x ∧
+        m.IsPositiveAt (x : K) ∧
+          (I : (FractionalIdeal (𝓞 K)⁰ K)ˣ) = toPrincipalIdeal (𝓞 K) K x}
+
+end RayModulus
+
+end NumberField
+
+/-- The ray class group attached to a modulus. -/
+abbrev RayClassGroup {K : Type*} [Field K] [NumberField K] (m : NumberField.RayModulus K) :=
+  m.IdealGroup ⧸ m.PrincipalSubgroup
+
+namespace RayClassGroup
+
+variable {K : Type*} [Field K] [NumberField K]
+
+/-- A nonzero square is positive at every real place in any ray modulus. -/
+theorem isPositiveAt_sq_of_ne_zero (m : NumberField.RayModulus K) (x : K)
+    (hx : x ≠ 0) :
+    m.IsPositiveAt (x ^ 2) := by
+  intro w hw
+  have hσx : w.1.embedding_of_isReal w.2 x ≠ 0 :=
+    (_root_.map_ne_zero (w.1.embedding_of_isReal w.2)).mpr hx
+  simpa using sq_pos_of_ne_zero hσx
+
+/-- Send an ideal in the coprime ideal group to its ray ideal class. -/
+def mk (m : NumberField.RayModulus K) : m.IdealGroup →* RayClassGroup m :=
+  QuotientGroup.mk' m.PrincipalSubgroup
+
+/-- Unfolding lemma for the ray ideal-class map. -/
+theorem mk_def (m : NumberField.RayModulus K) (I : m.IdealGroup) :
+    mk m I = QuotientGroup.mk' m.PrincipalSubgroup I := rfl
+
+end RayClassGroup
