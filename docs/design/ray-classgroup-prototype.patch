+module
+
+public import QNFMathlib.NumberTheory.NumberField.RayClassGroup.Basic
+
+/-!
+# Narrow Class Groups as Ray Class Groups
+
+This file packages the narrow/strict class group as the ray class group with
+trivial finite modulus and all real places in the infinite modulus.
+-/
+
+@[expose] public noncomputable section
+
+namespace RayClassGroup
+
+/-- The narrow/strict class group as the ray class group with trivial finite
+modulus and all real places in the infinite modulus. -/
+abbrev NarrowClassGroup (K : Type*) [Field K] [NumberField K] :=
+  RayClassGroup (NumberField.RayModulus.narrow K)
+
+end RayClassGroup
diff --git a/QNFMathlib/NumberTheory/NumberField/RayClassGroup/ClassGroup.lean b/QNFMathlib/NumberTheory/NumberField/RayClassGroup/ClassGroup.lean
new file mode 100644
index 00000000..956fccce
--- /dev/null
+++ b/QNFMathlib/NumberTheory/NumberField/RayClassGroup/ClassGroup.lean
@@ -0,0 +1,50 @@
+/-
+Copyright (c) 2026 Frankie Wang. All rights reserved.
+Released under Apache 2.0 license as described in the file LICENSE.
+Authors: Frankie Wang
+-/
+module
+
+public import QNFMathlib.NumberTheory.NumberField.RayClassGroup.Narrow
+
+/-!
+# Ray Class Groups and Ordinary Class Groups
+
+This file contains the natural map from the ray class group with trivial finite
+modulus to the ordinary wide ideal class group.
+-/
+
+@[expose] public noncomputable section
+
+open scoped nonZeroDivisors NumberField
+
+namespace RayClassGroup
+
+variable {K : Type*} [Field K] [NumberField K]
+
+theorem principalSubgroup_le_classGroup_ker (m : NumberField.RayModulus K) :
+    m.PrincipalSubgroup ≤ (ClassGroup.mk.comp m.IdealGroup.subtype).ker := by
+  rw [NumberField.RayModulus.PrincipalSubgroup]
+  apply (Subgroup.closure_le (ClassGroup.mk.comp m.IdealGroup.subtype).ker).mpr
+  rintro I ⟨x, _hfin, _hinf, hI⟩
+  change (ClassGroup.mk.comp m.IdealGroup.subtype) I = 1
+  rw [MonoidHom.comp_apply]
+  change ClassGroup.mk (I : (FractionalIdeal (𝓞 K)⁰ K)ˣ) = 1
+  rw [hI]
+  rw [ClassGroup.mk_eq_one_iff]
+  exact ⟨⟨x, by rw [coe_toPrincipalIdeal, FractionalIdeal.coe_spanSingleton]⟩⟩
+
+/-- The natural map from the ray class group to the ordinary wide ideal class group. -/
+noncomputable def toClassGroup (m : NumberField.RayModulus K) :
+    RayClassGroup m →* ClassGroup (𝓞 K) :=
+  QuotientGroup.lift m.PrincipalSubgroup (ClassGroup.mk.comp m.IdealGroup.subtype)
+    (principalSubgroup_le_classGroup_ker m)
+
+/-- The natural map to the wide class group sends a ray ideal class to the
+corresponding ordinary ideal class. -/
+@[simp]
+theorem toClassGroup_mk (m : NumberField.RayModulus K) (I : m.IdealGroup) :
+    toClassGroup m (mk m I) = ClassGroup.mk (I : (FractionalIdeal (𝓞 K)⁰ K)ˣ) :=
+  QuotientGroup.lift_mk m.PrincipalSubgroup (principalSubgroup_le_classGroup_ker m) I
+
+end RayClassGroup
